{
    "name": "obsidian-pdf-plus-sync",
    "version": "0.43.0",
    "description": "Independent continuation of PDF++ with cross-device reading progress.",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "lint": "eslint src/ --ext .ts,.tsx",
        "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "test": "node tests/reading-progress.mjs && node tests/free-text.mjs && node tests/free-text-service.mjs && node tests/free-text-worker.mjs"
    },
    "keywords": [],
    "author": "minLaoGe",
    "license": "MIT",
    "devDependencies": {
        "@cantoo/pdf-lib": "^2.4.3",
        "@capacitor/app": "^7.0.2",
        "@capacitor/core": "^7.4.3",
        "@capacitor/device": "^7.0.2",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.34.0",
        "@types/node": "^24.3.0",
        "@typescript-eslint/eslint-plugin": "8.x",
        "@typescript-eslint/parser": "8.x",
        "builtin-modules": "5.0.0",
        "electron": "^37.4.0",
        "esbuild": "0.25.9",
        "eslint": "^9.34.0",
        "globals": "^16.3.0",
        "monkey-around": "^3.0.0",
        "obsidian": "latest",
        "p-limit": "^7.1.1",
        "pdfjs-dist": "^5.4.54",
        "tslib": "2.8.1",
        "typescript": "5.6.3"
    },
    "contributors": [
        "Ryota Ushio (original PDF++)"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/minLaoGe/obsidian-pdf-plus-sync.git"
    },
    "dependencies": {
        "@noble/hashes": "1.8.0",
        "interactjs": "1.10.27"
    }
}
